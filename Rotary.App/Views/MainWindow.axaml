<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rotary.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Rotary.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Rotary">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <ui:FANavigationView PaneDisplayMode="Left"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False">
        <ui:FANavigationView.MenuItems>
            <ui:FANavigationViewItem Content="Home">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Home" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
        </ui:FANavigationView.MenuItems>

        <ui:FANavigationView.Content>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,*">
                <Border Grid.Column="0"
                        Width="240"
                        Margin="12,12,0,12"
                        IsVisible="{Binding IsCollectionTreeVisible}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0"
                                   Text="Collections"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding CollectionTree}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:CollectionTreeNodeViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}" />
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Columns"
                              IsVisible="{Binding IsCollectionTreeVisible}" />

                <Grid Grid.Column="2" Margin="12" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
                        <Button Grid.Column="0"
                                Content="☰"
                                Command="{Binding ToggleCollectionTreeCommand}"
                                Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding HttpMethods}"
                                  SelectedItem="{Binding Method}"
                                  Width="110" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding Url}"
                                 PlaceholderText="https://api.example.com/..."
                                 Margin="8,0" />
                        <Button Grid.Column="3"
                                Content="Send"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding !IsSending}" />
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Headers">
                            <DockPanel>
                                <Button DockPanel.Dock="Top"
                                        Content="Add Header"
                                        Command="{Binding AddHeaderCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4" />
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding RequestHeaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="Header name" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="Value" Margin="4,0" />
                                                    <Button Grid.Column="2"
                                                            Content="✕"
                                                            Command="{Binding #RootWindow.DataContext.RemoveHeaderCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Body">
                            <Grid RowDefinitions="Auto,*">
                                <TextBox Grid.Row="0"
                                         Text="{Binding RequestContentType}"
                                         PlaceholderText="Content-Type"
                                         Margin="0,0,0,4" />
                                <TextBox Grid.Row="1"
                                         Text="{Binding RequestBody}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Cascadia Code,Consolas,monospace" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Column="3"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" />

                <Grid Grid.Column="4" Margin="12" RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ResponseStatus}" FontWeight="Bold" />
                        <TextBlock Text="{Binding ResponseDuration}" Opacity="0.7" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ResponseError}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasError}"
                               Margin="0,0,0,8" />

                    <TabControl Grid.Row="2">
                        <TabItem Header="Body">
                            <TextBox Text="{Binding ResponseBody}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Cascadia Code,Consolas,monospace" />
                        </TabItem>
                        <TabItem Header="Headers">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ResponseHeaders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </ui:FANavigationView.Content>
    </ui:FANavigationView>

</Window>
